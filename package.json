{
  "name": "interop-default",
  "version": "1.0.0",
  "description": "Normalize CommonJS and ESM namespace default exports.",
  "keywords": [
    "cjs",
    "commonjs",
    "default",
    "esm",
    "interop",
    "module"
  ],
  "homepage": "https://github.com/cafi1212/interop-default#readme",
  "bugs": {
    "url": "https://github.com/cafi1212/interop-default/issues"
  },
  "license": "MIT",
  "author": "Leon Si <asaf@asafbeqiri.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cafi1212/interop-default.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run check && vp run test && vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.14"
}
